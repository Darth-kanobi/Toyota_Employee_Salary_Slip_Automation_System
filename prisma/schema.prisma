generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Employee {
  id          String         @id @default(cuid())
  employeeId  String         @unique
  name        String
  email       String
  designation String
  department  String?
  dateOfBirth DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  salaries    SalaryRecord[]
  emailLogs   EmailLog[]
}

model SalaryRecord {
  id         String    @id @default(cuid())
  employeeId String
  baseSalary Float
  hra        Float
  allowances Float
  deductions Float
  netSalary  Float
  month      Int
  year       Int
  createdAt  DateTime  @default(now())
  employee   Employee  @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
  emailLog   EmailLog?

  @@unique([employeeId, month, year])
}

model EmailLog {
  id             String       @id @default(cuid())
  salaryRecordId String       @unique
  employeeId     String
  recipientEmail String
  status         String       @default("pending")
  errorMessage   String?
  sentAt         DateTime?
  createdAt      DateTime     @default(now())
  salaryRecord   SalaryRecord @relation(fields: [salaryRecordId], references: [id], onDelete: Cascade)
  employee       Employee     @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)
}
